    "Machines are tied to one location. Loads from a similar machine elsewhere are never merged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Machines are tied to one location. Loads from a similar machine elsewhere are never merged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンは1つの場所に紐づきます。別の場所にある似たマシンの負荷が統合されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신은 한 위치에 연결됩니다. 다른 곳의 비슷한 머신 중량은 절대 병합되지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tập gắn với một địa điểm. Mức tạ từ máy tương tự ở nơi khác không bao giờ được gộp lại."
