      }
    },
    "If the destination already has a session, both sessions share that day. Nothing is deleted, and the moved session keeps its history.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the destination already has a session, both sessions share that day. Nothing is deleted, and the moved session keeps its history."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu ngày đích đã có buổi tập, hai buổi dùng chung ngày đó. Không có gì bị xóa, và buổi được dời vẫn giữ lịch sử."
          }
        }
      }
    },
