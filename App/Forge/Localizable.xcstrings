    "Eligible pressing work exceeds pulling work. Review the contributing sessions before changing the plan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eligible pressing work exceeds pulling work. Review the contributing sessions before changing the plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象となるプレス系の実施量がプル系を上回っています。プランを変更する前に関連セッションを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적격 밀기 운동이 당기기 운동을 초과합니다. 계획을 변경하기 전에 기여 세션을 검토하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khối lượng đẩy đủ điều kiện vượt quá khối lượng kéo. Hãy xem lại các buổi tập liên quan trước khi thay đổi kế hoạch."
          }
        }
      }
    },
    "Eligible pulling work exceeds pressing work. Review the contributing sessions before changing the plan.": {
      "localizations": {
        "en": {
