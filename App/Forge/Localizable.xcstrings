    "Record at least %lld eligible sessions and %lld eligible sets before ReguLift calculates ratios or recommends a change.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record at least %lld eligible sessions and %lld eligible sets before ReguLift calculates ratios or recommends a change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ReguLiftが比率を計算または変更を推奨する前に、対象セッションを%1$lld件、対象セットを%2$lld件記録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift가 비율을 계산하거나 변경을 추천하기 전에 적격 세션 %1$lld개와 적격 세트 %2$lld개를 기록하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy ghi ít nhất %1$lld buổi tập đủ điều kiện và %2$lld hiệp đủ điều kiện trước khi ReguLift tính toán tỷ số hoặc khuyến nghị thay đổi."
          }
        }
      }
    },
    "Record at least two check-ins to draw a trend. Missing days stay unknown, not zero.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record at least two check-ins to draw a trend. Missing days stay unknown, not zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傾向を描くには少なくとも2回のチェックインを記録してください。欠けている日はゼロではなく不明のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추세를 그리려면 체크인을 최소 두 번 기록하세요. 누락된 날은 0이 아닌 알 수 없음으로 유지됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy ghi ít nhất hai lần điểm danh để vẽ xu hướng. Các ngày thiếu vẫn là chưa biết, không phải bằng 0."
          }
        }
