    "That comes from Apple Health, and I keep it on this phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That comes from Apple Health, and I keep it on this phone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それはAppleヘルスケアから取得し、このスマートフォンに保存しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그것은 Apple 건강에서 가져온 것이며 이 휴대폰에 유지합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu đó đến từ Apple Health, và tôi giữ nó trên điện thoại này."
          }
        }
      }
    },
    "That doesn't match what I showed you, so I didn't apply it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't match what I showed you, so I didn't apply it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示した内容と一致しないため、適用しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보여드린 내용과 달라서 적용하지 않았습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung không khớp với những gì tôi đã hiển thị nên tôi không áp dụng."
          }
        }
      }
    },
    "That is the whole loop. You log, I program.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is the whole loop. You log, I program."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが全体の流れです。あなたが記録し、私が組みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이게 전체 흐름이에요. 당신은 기록하고, 제가 설계해요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là toàn bộ vòng lặp. Bạn ghi lại, tôi lập trình."
          }
        }
      }
    },
    "That item belongs to a different local account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That item belongs to a different local account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その器具は別のローカルアカウントに属しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 항목은 다른 로컬 계정에 속합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dụng cụ này thuộc tài khoản cục bộ khác."
          }
        }
      }
    },
    "That item no longer exists.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That item no longer exists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その器具はすでに存在しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 항목은 더 이상 존재하지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dụng cụ này không còn tồn tại."
          }
        }
      }
    },
    "That note was already deleted. Start a new note to save it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That note was already deleted. Start a new note to save it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのメモはすでに削除されています。もう一度保存するには、新しいメモを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 메모는 이미 삭제되었습니다. 다시 저장하려면 새 메모를 시작하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú đó đã bị xóa rồi. Hãy tạo ghi chú mới để lưu lại."
          }
        }
      }
    },
    "That suggestion is too old to apply now. Ask again and I'll rebuild it against your current plan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That suggestion is too old to apply now. Ask again and I'll rebuild it against your current plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この提案は古すぎて適用できません。もう一度聞いてくれれば、今の計画で作り直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제안은 너무 오래되어 적용할 수 없습니다. 다시 물어보면 현재 계획에 맞춰 새로 만들어 드릴게요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề xuất này đã quá cũ để áp dụng. Hỏi lại nhé, tôi sẽ dựng lại theo kế hoạch hiện tại của bạn."
          }
        }
      }
    },
    "That's already your plan: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's already your plan: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それがすでにあなたのプランです：%@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그것이 이미 당신의 플랜입니다: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó đã là kế hoạch của bạn: %@."
          }
        }
      }
    },
    "The app will switch to %@ right away.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app will switch to %@ right away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはすぐに%@に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 바로 %@(으)로 전환됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng sẽ chuyển sang %@ ngay."
          }
        }
      }
    },
    "The audit needs a workout or an import. Log a couple of sessions or bring your old log.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audit needs a workout or an import. Log a couple of sessions or bring your old log."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断にはワークアウトかインポートが必要です。数回記録するか、以前のログを取り込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단에는 운동 기록이나 가져오기가 필요해요. 몇 회 기록하거나 이전 로그를 가져와 보세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần một buổi tập hoặc dữ liệu nhập để kiểm tra. Ghi vài buổi hoặc mang nhật ký cũ vào."
          }
        }
      }
    },
    "The bar is counted as part of the number you record.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bar is counted as part of the number you record."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャフトは、あなたが記録する数値の一部としてカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바는 기록하는 숫자에 포함되어 계산됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh đòn được tính trong con số bạn ghi."
          }
        }
      }
    },
    "The coach server isn't configured in this build.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coach server isn't configured in this build."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドではコーチサーバーが設定されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에서는 코치 서버가 설정되지 않았어요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dựng này chưa cấu hình máy chủ HLV."
          }
        }
      }
    },
    "The copy contains training days only. Workout history, coach memory, your notes and your profile identity are never included.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy contains training days only. Workout history, coach memory, your notes and your profile identity are never included."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーにはトレーニング日のみが含まれます。ワークアウト履歴、コーチの記憶、メモ、プロフィール情報が含まれることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사본에는 훈련 날짜만 포함됩니다. 운동 기록, 코치 메모리, 메모, 프로필 신원은 절대 포함되지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao chỉ chứa các ngày tập. Lịch sử buổi tập, bộ nhớ của HLV, ghi chú và danh tính hồ sơ của bạn không bao giờ được đưa vào."
          }
        }
      }
    },
    "The first stack step cannot be negative.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first stack step cannot be negative."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタックの最初の刻みは負の値にできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 스택 단계는 음수일 수 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bước đầu của khối tạ không thể âm."
          }
        }
      }
    },
    "The link is unlisted — it is not searchable and never appears in a feed — but it is a bearer link: whoever holds the code can read and import the program. Revoke it any time to stop future access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is unlisted — it is not searchable and never appears in a feed — but it is a bearer link: whoever holds the code can read and import the program. Revoke it any time to stop future access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクは限定公開です — 検索されず、フィードにも表示されません — ただしベアラーリンクです。コードを持つ人は誰でもプログラムを読み取ってインポートできます。今後のアクセスを止めるにはいつでも取り消してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크는 비공개로 검색되지 않고 피드에도 표시되지 않지만 베어러 링크입니다. 코드를 가진 누구나 프로그램을 읽고 가져올 수 있습니다. 향후 접근을 막으려면 언제든 철회하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết là không công khai — không thể tìm kiếm và không bao giờ xuất hiện trong bảng tin — nhưng nó là liên kết mang quyền truy cập: ai giữ mã đều có thể đọc và nhập chương trình. Hãy thu hồi bất cứ lúc nào để chặn truy cập trong tương lai."
          }
        }
      }
    },
    "The note is removed from your timeline. Nothing else on this device changes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note is removed from your timeline. Nothing else on this device changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモがタイムラインから削除されます。この端末の他には何も変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모가 타임라인에서 제거됩니다. 이 기기의 다른 것은 변경되지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú bị gỡ khỏi dòng thời gian. Không có gì khác trên thiết bị này thay đổi."
          }
        }
      }
    },
    "The number includes the bar, for example a 20 kg bar plus the plates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number includes the bar, for example a 20 kg bar plus the plates."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値にはシャフトが含まれます。たとえば20 kgのシャフトにプレートを加えたものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자에는 바가 포함됩니다. 예를 들어 20 kg 바에 플레이트를 더한 값입니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con số đã gồm thanh đòn, ví dụ thanh đòn 20 kg cộng bánh tạ."
          }
        }
      }
    },
    "The number includes the bar, so enter the bar weight.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number includes the bar, so enter the bar weight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値にはシャフトが含まれるため、シャフトの重さを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자에는 바가 포함되므로 바 중량을 입력하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con số đã gồm thanh đòn, nên hãy nhập trọng lượng thanh đòn."
          }
        }
      }
    },
    "The number is how much the machine helps you, not the weight you lift.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number is how much the machine helps you, not the weight you lift."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値はマシンがどれだけ補助するかを表し、持ち上げる重さではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 숫자는 머신이 보조하는 정도이며, 들어 올리는 중량이 아닙니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con số là mức máy hỗ trợ bạn, không phải mức tạ bạn nâng."
          }
        }
      }
    },
    "The number is one side of the bar, not both sides.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number is one side of the bar, not both sides."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値はシャフトの片側の値で、両側ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자는 바의 한쪽이며 양쪽이 아닙니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con số là một bên thanh đòn, không phải cả hai bên."
          }
        }
      }
    },
    "The number is the plates alone. The bar is added on top.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number is the plates alone. The bar is added on top."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値はプレートのみです。シャフトはその上に加算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자는 플레이트만이며 바는 추가로 더해집니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con số chỉ tính bánh tạ. Thanh đòn được cộng thêm vào."
          }
        }
      }
    },
    "The number is the weight of one dumbbell, not the pair.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number is the weight of one dumbbell, not the pair."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値はダンベル1個の重さで、一対ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자는 덤벨 한 개의 중량이며 한 쌍이 아닙니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con số là mức tạ của một quả tạ đơn, không phải cả đôi."
          }
        }
      }
    },
    "The number is the whole stack value the machine prints.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number is the whole stack value the machine prints."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値はマシンに表示されるスタック全体の値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자는 머신이 표시하는 전체 스택 값입니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con số là giá trị cả khối tạ mà máy hiển thị."
          }
        }
      }
    },
    "The same redacted copy as a file, sent with the system share sheet. Works offline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same redacted copy as a file, sent with the system share sheet. Works offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ加工済みコピーをファイルとして、システムの共有シートで送信します。オフラインで動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 개인정보 제거 사본을 파일로, 시스템 공유 시트로 전송합니다. 오프라인에서 작동합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng bản đã lược bỏ dưới dạng tệp, gửi qua bảng chia sẻ của hệ thống. Hoạt động ngoại tuyến."
          }
        }
      }
    },
    "The sets in it are removed too. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sets in it are removed too. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その中のセットも削除されます。これは元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 안의 세트도 제거됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các hiệp trong đó cũng bị xóa. Việc này không thể hoàn tác."
          }
        }
      }
    },
    "The smallest change must be greater than zero.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The smallest change must be greater than zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小刻みは0より大きい必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최소 증감은 0보다 커야 합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bước thay đổi nhỏ nhất phải lớn hơn không."
          }
        }
      }
    },
    "The smallest jump the equipment can actually make.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The smallest jump the equipment can actually make."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "器具が実際に変えられる最小の刻みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기구가 실제로 만들 수 있는 최소 증감."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bước nhảy nhỏ nhất mà dụng cụ thật sự có thể tăng."
          }
        }
      }
    },
    "The timeline could not be read": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timeline could not be read"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムラインを読み込めませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임라인을 읽을 수 없습니다"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được dòng thời gian"
          }
        }
      }
    },
    "The timeline shows finished workouts, body check-ins, progress photos, program changes and your own notes. Nothing else is invented here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timeline shows finished workouts, body check-ins, progress photos, program changes and your own notes. Nothing else is invented here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムラインには、完了したワークアウト、ボディチェックイン、進捗写真、プログラムの変更、自分のメモが表示されます。ここで他に何かが作り出されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임라인에는 완료한 운동, 바디 체크인, 진행 사진, 프로그램 변경, 직접 작성한 메모가 표시됩니다. 여기에 다른 것은 만들어내지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dòng thời gian hiển thị các buổi tập đã hoàn thành, số đo cơ thể, ảnh tiến độ, thay đổi giáo án và ghi chú của bạn. Không có gì khác được tạo ra ở đây."
          }
        }
      }
    },
    "The unit keeps its loads; only the label changes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The unit keeps its loads; only the label changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "器具は負荷を保持し、ラベルだけが変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기구는 중량을 유지하며 라벨만 변경됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dụng cụ vẫn giữ các mức tạ; chỉ nhãn thay đổi."
          }
        }
      }
    },
    "The voice model didn't download. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice model didn't download. Try again."
