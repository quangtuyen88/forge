          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적격 당기기 운동이 밀기 운동을 초과합니다. 계획을 변경하기 전에 기여 세션을 검토하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
