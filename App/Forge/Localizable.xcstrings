    "Needs %lld more verified record%@. Until then no progress figure is shown and the goal cannot be marked achieved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs %lld more verified record%@. Until then no progress figure is shown and the goal cannot be marked achieved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済み記録がさらに%1$lld件%2$@必要です。それまでは進捗の数値は表示されず、目標を達成済みにできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 기록 %1$lld개%2$@가 더 필요합니다. 그 전까지는 진행 수치가 표시되지 않으며 목표를 달성으로 표시할 수 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần thêm %1$lld bản ghi%2$@ đã xác minh. Cho đến lúc đó, không có con số tiến độ nào được hiển thị và mục tiêu không thể được đánh dấu là đã đạt."
          }
        }
      }
