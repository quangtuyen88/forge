    "Calm, precise, relentless." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calm, precise, relentless."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冷静に、正確に、飽くなし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차분하게, 정확하게, 멈추지 않게."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冷静、精准、永不停歇。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bình tĩnh, chính xác, không ngừng nghỉ."
          }
        }
      }
    },
    "Calories, protein, carbs and fat tuned to your phase and training volume — set once, then just log." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calories, protein, carbs and fat tuned to your phase and training volume — set once, then just log."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カロリー・たんぱく質・炭水化物・脂質をフェーズとボリュームに合わせて調整。一度設定すれば、あとは記録するだけ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "칼로리·단백질·탄수화물·지방을 단계와 볼륨에 맞춰 조절해요. 한 번 설정하면 그다음은 기록만 하면 돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热量、蛋白质、碳水与脂肪随你的阶段和训练量自动匹配——设定一次，之后只管记录。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calo, protein, carb và chất béo khớp với giai đoạn và khối lượng tập — đặt một lần, sau đó chỉ việc ghi."
          }
        }
      }
    },
