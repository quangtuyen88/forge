    "Reviewing builds the copy in memory. Nothing is published and nothing is sent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviewing builds the copy in memory. Nothing is published and nothing is sent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認はコピーをメモリ上に構築します。何も公開・送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토하면 사본이 메모리에 생성됩니다. 게시되거나 전송되는 것은 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc xem lại xây dựng bản sao trong bộ nhớ. Không có gì được công bố và không có gì được gửi đi."
          }
        }
      }
    },
    "Revision %lld": {
