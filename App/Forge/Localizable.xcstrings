    "%lld set%@ you marked are left out of these charts and awards — they stay in History as recorded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld set%@ you marked are left out of these charts and awards — they stay in History as recorded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたがマークした%1$lldセット%2$@は、これらのチャートとアワードから除外されます — 記録は履歴にそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시한 %1$lld개 세트%2$@는 이 차트와 어워드에서 제외되며 기록된 대로 기록에 남습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld hiệp%2$@ bạn đã đánh dấu bị loại khỏi các biểu đồ và phần thưởng này — chúng vẫn ở trong Lịch sử như đã ghi."
          }
        }
      }
    },
    "%lld set%@ you marked as cut short or uncomfortable are not counted as eligible work, so they are not posted as records. Your logged sets stay in History.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld set%@ you marked as cut short or uncomfortable are not counted as eligible work, so they are not posted as records. Your logged sets stay in History."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短縮または不快とマークした%1$lldセット%2$@は対象の実施として数えられず、記録として投稿されません。記録したセットは履歴に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄이거나 불편하다고 표시한 %1$lld개 세트%2$@는 적격 작업으로 계산되지 않아 기록으로 게시되지 않습니다. 기록된 세트는 기록에 남습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld hiệp%2$@ bạn đánh dấu là bị cắt ngắn hoặc không thoải mái không được tính là khối lượng đủ điều kiện, nên chúng không được ghi là kỷ lục. Các hiệp đã ghi của bạn vẫn ở trong Lịch sử."
          }
        }
      }
    },
