    },
    "Sessions are rebuilt from your current program, gym and time budget. Completed, moved and skipped records for this week are replaced.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions are rebuilt from your current program, gym and time budget. Completed, moved and skipped records for this week are replaced."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションは現在のプログラム、ジム、時間予算から再構築されます。今週の完了・移動・スキップの記録は置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션은 현재 프로그램, 헬스장, 시간 예산으로 다시 구성됩니다. 이번 주의 완료, 이동, 건너뜀 기록은 교체됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các buổi tập được dựng lại từ chương trình, phòng tập và quỹ thời gian hiện tại. Ghi nhận hoàn thành, dời lịch và bỏ qua của tuần này sẽ bị thay thế."
          }
        }
      }
    },
