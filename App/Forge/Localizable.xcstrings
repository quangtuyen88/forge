    "Unit, convention, step, bar or stack settings changed, so this becomes revision %lld. Loads recorded under revision %lld stay separate and keep their original meaning.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unit, convention, step, bar or stack settings changed, so this becomes revision %lld. Loads recorded under revision %lld stay separate and keep their original meaning."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đơn vị, cách tính, bước tăng, thanh đòn hay khối tạ đã đổi, nên dụng cụ này thành phiên bản %lld. Các mức tạ ghi theo phiên bản %lld vẫn tách riêng và giữ nguyên ý nghĩa ban đầu."
          }
        }
      }
    },
    "Units": {
