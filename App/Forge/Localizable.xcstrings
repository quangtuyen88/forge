    },
    "Saving now keeps this as Needs review: the smallest change is missing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving now keeps this as Needs review: the smallest change is missing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今保存すると「要確認」のままです。最小刻みが未入力です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 저장하면 검토 필요로 유지됩니다: 최소 증감이 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu bây giờ thì mục này vẫn ở dạng Cần xem lại: còn thiếu bước thay đổi nhỏ nhất."
          }
        }
      }
    },
    "Saving now keeps this as Needs review: the weight per stack step is missing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving now keeps this as Needs review: the weight per stack step is missing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今保存すると「要確認」のままです。スタックの刻みごとの重さが未入力です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 저장하면 검토 필요로 유지됩니다: 스택 단계당 중량이 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu bây giờ thì mục này vẫn ở dạng Cần xem lại: còn thiếu mức tạ mỗi bước của khối tạ."
          }
        }
      }
    },
    "Saving now keeps this as Needs review: we still would not know what the number counts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving now keeps this as Needs review: we still would not know what the number counts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今保存すると「要確認」のままです。数値が何を数えているのかがまだ分かりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 저장하면 검토 필요로 유지됩니다: 숫자가 무엇을 세는지 여전히 알 수 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu bây giờ thì mục này vẫn ở dạng Cần xem lại: chúng tôi vẫn không biết con số tính gì."
          }
        }
      }
    },
    "Saving now keeps this as Needs review: without a unit, numbers cannot be converted or compared.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving now keeps this as Needs review: without a unit, numbers cannot be converted or compared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今保存すると「要確認」のままです。単位がないと数値を換算・比較できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 저장하면 검토 필요로 유지됩니다: 단위가 없으면 숫자를 변환하거나 비교할 수 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu bây giờ thì mục này vẫn ở dạng Cần xem lại: không có đơn vị thì các con số không thể quy đổi hay so sánh."
          }
        }
      }
    },
