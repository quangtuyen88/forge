    "Regulift changes one variable for four weeks. Everything else stays as stable as possible.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift changes one variable for four weeks. Everything else stays as stable as possible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguliftは4週間、1つの変数だけを変えます。それ以外はすべて可能な限り一定に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift는 4주 동안 한 가지 변수만 바꿉니다. 나머지는 최대한 안정적으로 유지됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift thay đổi một biến số trong bốn tuần. Mọi thứ khác giữ ổn định nhất có thể."
          }
        }
      }
    },
    "Regulift reads sleep and resting heart rate from Health to score readiness. Optional.": {
