          }
        }
      }
    },
    "The audit needs a workout or an import. Log a couple of sessions or bring your old log.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audit needs a workout or an import. Log a couple of sessions or bring your old log."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断にはワークアウトかインポートが必要です。数回記録するか、以前のログを取り込んでください。"
          }
