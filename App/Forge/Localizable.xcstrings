    "Counted as %lld sessions per week × %lld weeks = %lld completed sessions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted as %lld sessions per week × %lld weeks = %lld completed sessions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週%1$lldセッション × %2$lld週 = %3$lldセッション完了としてカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 %1$lld회 × %2$lld주 = 완료 세션 %3$lld개로 계산됨."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được tính là %1$lld buổi mỗi tuần × %2$lld tuần = %3$lld buổi đã hoàn thành."
          }
        }
      }
    },
    "Counted from %lld recorded recommendation%@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted from %lld recorded recommendation%@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld件の記録済み推奨%2$@からカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 추천 %1$lld개%2$@로부터 계산됨."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được tính từ %1$lld khuyến nghị%2$@ đã ghi."
          }
        }
      }
    },
    "Counted from completed sessions after this goal was created. A percentage target is not offered: a rate cannot be counted from records without inventing one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted from completed sessions after this goal was created. A percentage target is not offered: a rate cannot be counted from records without inventing one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この目標の作成後に完了したセッションからカウントされます。割合の目標は提供されません。記録から率を数えるにはでっち上げが必要になるためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 목표 생성 후 완료된 세션으로부터 계산됨. 백분율 목표는 제공되지 않습니다: 비율은 기록에서 지어내지 않고는 계산할 수 없기 때문입니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được tính từ các buổi tập đã hoàn thành sau khi mục tiêu này được tạo. Không đưa ra mục tiêu theo tỷ lệ phần trăm: không thể tính tỷ lệ từ bản ghi mà không bịa ra một con số."
          }
        }
      }
    },
