    },
    "This week has no sessions on it yet. Lay out the days you want in the week designer — nothing is scheduled until you do.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week has no sessions on it yet. Lay out the days you want in the week designer — nothing is scheduled until you do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週はまだセッションがありません。週デザイナーで希望の曜日を設定してください。設定するまで何も予定されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주에는 아직 세션이 없습니다. 주간 디자이너에서 원하는 요일을 정하세요. 정하기 전까지는 아무것도 예약되지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuần này chưa có buổi tập nào. Hãy sắp xếp các ngày bạn muốn trong trình thiết kế tuần — sẽ không có gì được lên lịch cho đến khi bạn làm."
          }
        }
      }
    },
