    "Recognises commands on this phone, with no network at all. Needs a one-time model download.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognises commands on this phone, with no network at all. Needs a one-time model download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークなしで、この端末だけでコマンドを認識します。初回のみモデルのダウンロードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 없이 이 기기에서만 명령을 인식합니다. 최초 1회 모델 다운로드가 필요합니다."
          }
        },
        "vi": {
