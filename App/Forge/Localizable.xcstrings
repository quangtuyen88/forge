        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 모델을 내려받지 못했습니다. 다시 시도하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được mô hình giọng nói. Hãy thử lại."
          }
        }
      }
    },
    "Theme": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme"
          }
        },
        "ja": {
