    "You already applied this one and your program hasn't changed since, so nothing was changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already applied this one and your program hasn't changed since, so nothing was changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはすでに適用済みで、その後プログラムも変わっていないため、何も変更されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 이것을 적용했고 그 후 프로그램이 변경되지 않았으므로 아무것도 변경되지 않았습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã áp dụng gợi ý này và chương trình của bạn chưa thay đổi kể từ đó, nên không có gì thay đổi."
          }
        }
      }
    },
    "You are looking at the week of %@. Regenerate to lay out the week starting %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are looking at the week of %@. Regenerate to lay out the week starting %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在表示しているのは%1$@の週です。再作成すると%2$@から始まる週を組み立てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 주를 보고 있습니다. %@부터 시작하는 주를 구성하려면 다시 생성하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang xem tuần bắt đầu %@. Hãy tạo lại để dựng tuần bắt đầu %@."
          }
        }
      }
    },
    "You asked for this in Coach.": {
      "localizations": {
        "en": {
