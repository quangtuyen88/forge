    "Not counted for PRs, badges or Crew: sets came in too fast or a load jumped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not counted for PRs, badges or Crew: sets came in too fast or a load jumped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PR・バッジ・クルーには反映されません：セット間隔が短すぎるか、重量が急上昇しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PR·배지·크루에 반영되지 않음: 세트 간격이 너무 짧거나 중량이 급상승했습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tính cho PR, huy hiệu hay Nhóm: các hiệp ghi quá nhanh hoặc mức tạ nhảy vọt."
