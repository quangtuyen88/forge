    "%lld of your recent counting sets carry the plan's target rather than a rating you gave.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of your recent counting sets carry the plan's target rather than a rating you gave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の対象セットのうち %1$lld 件は、あなたの評価ではなくプランの目標値が入っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 집계 대상 세트 중 %1$lld개는 직접 평가한 값이 아니라 플랜의 목표값입니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld hiệp được tính gần đây mang mục tiêu của kế hoạch chứ không phải điểm bạn chấm."
          }
        }
      }
    },
    "%lld plan changes in 2 weeks. What isn't fitting: time, exercises, difficulty or days? A plan you can repeat shows progress more clearly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld plan changes in 2 weeks. What isn't fitting: time, exercises, difficulty or days? A plan you can repeat shows progress more clearly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2週間で%1$lld回プランを変更しました。何が合いませんか：時間、種目、強度、それとも頻度？繰り返せるプランほど進歩がはっきり見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2주 동안 플랜을 %1$lld번 바꿨습니다. 무엇이 맞지 않나요: 시간, 운동, 난이도, 요일? 반복할 수 있는 플랜이 진전을 더 분명히 보여줍니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lần thay đổi kế hoạch trong 2 tuần. Điều gì chưa phù hợp: thời gian, bài tập, độ khó hay số ngày? Kế hoạch lặp lại được sẽ cho thấy tiến bộ rõ hơn."
          }
        }
      }
    },
    "%lld planned session%@ remain with %lld day%@ left. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld planned session%@ remain with %lld day%@ left. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
