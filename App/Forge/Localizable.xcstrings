        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ phòng tập của bạn liệt kê %lld dụng cụ. %lld trong đó — máy tập và máy cáp — sẽ vào dạng Cần xem lại, vì ứng dụng không đoán đơn vị hay ý nghĩa con số của chúng."
          }
