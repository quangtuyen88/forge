    "Apple Intelligence answers questions on this iPhone. Plan changes still use the Regulift coach service.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence answers questions on this iPhone. Plan changes still use the Regulift coach service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple IntelligenceがこのiPhone上で質問に回答します。プラン変更は引き続きReguliftのコーチサービスを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 이 iPhone에서 질문에 답합니다. 플랜 변경은 계속 Regulift 코치 서비스를 사용해요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence trả lời câu hỏi trên iPhone này. Thay đổi kế hoạch vẫn dùng dịch vụ HLV Regulift."
          }
        }
      }
    },
    "Apple Intelligence is not available on this device; the coach service answers instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is not available on this device; the coach service answers instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceはこの端末では利用できません。代わりにコーチサービスが回答します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence는 이 기기에서 사용할 수 없어요. 대신 코치 서비스가 답해요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence không khả dụng trên thiết bị này; dịch vụ HLV sẽ trả lời thay."
          }
        }
      }
    },
