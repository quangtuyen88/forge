    "Built around your gym and your flags. Log RPE and I adjust from set one." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built around your gym and your flags. Log RPE and I adjust from set one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのジムとフラグに合わせて組みました。RPEを記録すれば、最初のセットから調整します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 체육관과 플래그에 맞춰 구성했어요. RPE를 기록하면 첫 세트부터 조정해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "围绕你的健身房和标记编排。记录 RPE，我从第一组就开始调整。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chương trình xây theo phòng gym và các cờ của bạn. Ghi RPE, tôi điều chỉnh ngay từ hiệp đầu."
          }
        }
      }
    },
