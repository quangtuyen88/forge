    "Applies from today. Workouts you finished stay saved, and you stay in week %lld of %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies from today. Workouts you finished stay saved, and you stay in week %lld of %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日から適用されます。終えたワークアウトはそのまま保存され、第%1$lld週（全%2$lld週）のまま進みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘부터 적용됩니다. 완료한 운동은 그대로 저장되고, %1$lld/%2$lld주 차를 계속 진행합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng từ hôm nay. Các buổi tập đã hoàn thành vẫn được lưu, bạn vẫn ở tuần %1$lld của %2$lld."
          }
        }
      }
    },
