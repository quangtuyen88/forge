          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼륨은 5주 동안 쌓이다가 회복을 위해 줄어듭니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khối lượng tập tăng dần trong năm tuần, rồi giảm để hồi phục."
          }
        }
      }
    },
    "Volume changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume changed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボリュームが変更されました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼륨 변경됨"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thay đổi khối lượng tập"
          }
        }
      }
    },
    "Volume decisions read that field either way. Rate your hard sets and this page describes what you actually did.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume decisions read that field either way. Rate your hard sets and this page describes what you actually did."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボリュームの判断はいずれにせよこの値を読み取ります。きついセットを評価すれば、このページは実際の内容を反映します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼륨 판단은 어느 쪽이든 이 값을 읽습니다. 힘든 세트를 평가하면 이 페이지가 실제로 한 것을 설명합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyết định khối lượng vẫn đọc trường đó. Hãy chấm điểm các hiệp nặng để trang này mô tả đúng những gì bạn đã làm."
          }
        }
      }
    },
    "Volume landmarks, effort-based load changes and planned deloads decide every session. Each change comes with its reason.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume landmarks, effort-based load changes and planned deloads decide every session. Each change comes with its reason."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボリューム基準、努力度に基づく負荷調整、計画的なディロードがすべてのセッションを決めます。変更には必ず理由が付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼륨 기준, 노력도 기반 중량 조정, 계획된 딜로드가 모든 세션을 결정해요. 모든 변경에는 이유가 함께 표시돼요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mốc khối lượng, điều chỉnh tạ theo mức gắng sức và deload theo kế hoạch quyết định mỗi buổi tập. Mỗi thay đổi đều kèm lý do."
          }
        }
      }
    },
