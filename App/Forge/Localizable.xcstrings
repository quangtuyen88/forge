    "Adherence appears once a session has either been completed or missed — a percentage with nothing settled would be invented.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adherence appears once a session has either been completed or missed — a percentage with nothing settled would be invented."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行率は、セッションが完了または未実施になってから表示されます。何も確定していない状態の割合は、でっち上げた数字になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이행률은 세션이 완료되거나 놓친 후에 표시됩니다. 확정된 것이 없는 백분율은 만들어낸 값이기 때문입니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức độ bám lịch chỉ hiện khi đã có buổi được hoàn thành hoặc bị bỏ — tỷ lệ phần trăm khi chưa có gì ngã ngũ sẽ là con số bịa ra."
          }
        }
      }
    },
