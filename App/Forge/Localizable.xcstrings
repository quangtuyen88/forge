            "state": "translated",
            "value": "テーマ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề"
          }
        }
      }
    },
    "Then numbers mean the same thing and progress is real.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then numbers mean the same thing and progress is real."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そうすれば数値は同じ意味になり、進捗は本物になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래야 숫자가 같은 의미를 갖고 진행이 진짜가 됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đó các con số mới cùng nghĩa và tiến bộ mới là thật."
          }
        }
      }
    },
    "There is already a “%@” at %@. Saving adds a separate unit — loads recorded on the two are never merged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is already a “%@” at %@. Saving adds a separate unit — loads recorded on the two are never merged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@にはすでに「%1$@」があります。保存すると別の器具が追加され、2つに記録された負荷が統合されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 %2$@에 “%1$@”이(가) 있습니다. 저장하면 별도의 기구가 추가되며, 두 기구에 기록된 중량은 절대 병합되지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có một “%@” ở %@. Lưu lại sẽ thêm một dụng cụ riêng — mức tạ ghi trên hai dụng cụ không bao giờ được gộp."
          }
        }
      }
    },
    "These values are intentionally zero": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These values are intentionally zero"
          }
        },
        "ja": {
