    "Rings fill as your crew logs. Yours counts too.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings fill as your crew logs. Yours counts too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クルーの記録でリングが埋まります。自分のもカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크루가 기록하면 링이 차요. 당신 것도 포함돼요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vòng sẽ đầy khi nhóm ghi chép. Phần của bạn cũng được tính."
          }
        }
      }
    },
    "Run one controlled four-week change, then keep or revert it using your logged results.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run one controlled four-week change, then keep or revert it using your logged results."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理された4週間の変更を1つ実行し、記録した結果をもとに維持するか元に戻すかを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통제된 4주 변경을 한 번 실행한 다음, 기록한 결과를 바탕으로 유지하거나 되돌리세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy một thay đổi có kiểm soát trong bốn tuần, rồi giữ lại hoặc hoàn tác dựa trên kết quả bạn đã ghi."
          }
        }
      }
    },
