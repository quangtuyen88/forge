    "Works offline. Entries, notes and hidden items are stored on this device; nothing here is fetched.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works offline. Entries, notes and hidden items are stored on this device; nothing here is fetched."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động ngoại tuyến. Các mục, ghi chú và mục đã ẩn đều lưu trên thiết bị này; không có gì được tải về."
          }
        }
      }
    },
    "Works offline. The timeline reads records already stored on this device; browsing it makes no network request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works offline. The timeline reads records already stored on this device; browsing it makes no network request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインで動作します。タイムラインはこの端末に保存済みの記録を読み取るだけなので、閲覧してもネットワーク通信は発生しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인으로 작동합니다. 타임라인은 이 기기에 저장된 기록만 읽으므로 탐색해도 네트워크 요청이 발생하지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động ngoại tuyến. Dòng thời gian chỉ đọc các bản ghi đã lưu trên thiết bị này; duyệt dòng thời gian không tạo yêu cầu mạng."
          }
        }
      }
    },
