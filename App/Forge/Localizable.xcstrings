    "A structured program file: format version, versions and training days. Paste it below, or open one from Files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A structured program file: format version, versions and training days. Paste it below, or open one from Files."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "構造化されたプログラムファイル: フォーマットバージョン、バージョン、トレーニング日が含まれます。下に貼り付けるか、ファイルアプリから開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구조화된 프로그램 파일: 형식 버전, 버전 및 훈련 날짜. 아래에 붙여넣거나 파일에서 여세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp chương trình có cấu trúc: phiên bản định dạng, các phiên bản và các ngày tập. Hãy dán bên dưới, hoặc mở một tệp từ Files."
          }
        }
      }
    },
    "A week plan appears once your profile is loaded. It is built from your program, gym and time budget.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A week plan appears once your profile is loaded. It is built from your program, gym and time budget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週プランはプロフィールが読み込まれると表示されます。プログラム、ジム、時間予算から作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필이 로드되면 주간 계획이 표시됩니다. 프로그램, 헬스장, 시간 예산을 바탕으로 구성됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch tập tuần sẽ hiện khi hồ sơ của bạn được tải. Nó được dựng từ chương trình, phòng tập và quỹ thời gian."
          }
        }
      }
    },
    "AI coaches for training programming, not medical advice. You can change your coach later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI coaches for training programming, not medical advice. You can change your coach later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIコーチはトレーニングプログラミング用です。医療アドバイスではありません。コーチは後から設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 코치는 트레이닝 프로그래밍용이에요. 의료 조언이 아니에요. 코치는 나중에 설정에서 바꿀 수 있어요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HLV AI dùng để lập chương trình tập luyện, không phải tư vấn y tế. Bạn có thể đổi HLV sau này trong Cài đặt."
          }
        }
      }
    },
