    "Analyse a program first — sharing is built from the version you previewed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse a program first — sharing is built from the version you previewed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にプログラムを解析してください — 共有はプレビューしたバージョンから作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 프로그램을 분석하세요 — 공유는 미리 본 버전을 바탕으로 만들어집니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy phân tích chương trình trước — việc chia sẻ được xây dựng từ phiên bản bạn đã xem trước."
          }
        }
      }
    },
    "Analysing only reads the file. Nothing is saved, and nothing is activated, until you tap it below.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysing only reads the file. Nothing is saved, and nothing is activated, until you tap it below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析はファイルを読み取るだけです。下でタップするまで、何も保存・有効化されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석은 파일만 읽습니다. 아래에서 탭하기 전까지는 저장되거나 활성화되지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc phân tích chỉ đọc tệp. Không có gì được lưu hay kích hoạt cho đến khi bạn chạm vào bên dưới."
          }
        }
      }
    },
