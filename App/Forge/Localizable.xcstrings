    "Done. %@ → %@ from your next session. You'll see it under %@'s adjustments on Today; undo in Settings → Training.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. %@ → %@ from your next session. You'll see it under %@'s adjustments on Today; undo in Settings → Training."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了しました。次回のセッションから%@ → %@になります。今日の画面で%@の調整として表示されます。元に戻すには設定 → トレーニングへ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료했어요. 다음 세션부터 %@ → %@예요. 오늘 화면에서 %@의 조정으로 보여요. 되돌리려면 설정 → 훈련으로."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong. %@ → %@ từ buổi tập tiếp theo. Bạn sẽ thấy mục này trong điều chỉnh của %@ ở màn hình Hôm nay; hoàn tác trong Cài đặt → Tập luyện."
          }
        }
      }
    },
    "Done. A fresh 6-week block starts today from week 1.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. A fresh 6-week block starts today from week 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了しました。新しい6週間のブロックが今日、第1週から始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료했어요. 오늘부터 새 6주 블록이 1주차로 시작돼요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong. Khối 6 tuần mới bắt đầu hôm nay từ tuần 1."
          }
        }
      }
    },
    "Done. Deload starts now: fewer sets this week, loads stay. Today shows the deload plan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. Deload starts now: fewer sets this week, loads stay. Today shows the deload plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了しました。ディロードを今すぐ開始します: 今週はセット数を減らし、重量は維持します。今日の画面にディロード計画が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료했어요. 디로드를 지금 시작해요: 이번 주는 세트를 줄이고, 중량은 유지돼요. 오늘 화면에 디로드 계획이 표시돼요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong. Giảm tải bắt đầu ngay: tuần này ít hiệp hơn, mức tạ giữ nguyên. Hôm nay sẽ hiện kế hoạch giảm tải."
          }
        }
      }
    },
    "Double tap to mute or unmute. Touch and hold to repeat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap to mute or unmute. Touch and hold to repeat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップでミュートを切り替え、長押しで最後のガイダンスを繰り返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이중 탭으로 음소거를 전환하고 길게 눌러 마지막 안내를 반복합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm hai lần để tắt/bật tiếng. Chạm và giữ để lặp lại hướng dẫn."
          }
        }
      }
    },
