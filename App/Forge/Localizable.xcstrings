    "RPE starts on your plan's target. Only sets you rated yourself count toward effort.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RPE starts on your plan's target. Only sets you rated yourself count toward effort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RPEはプランの目標値から始まります。自分で評価したセットだけが主観強度に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RPE는 플랜의 목표값에서 시작합니다. 직접 평가한 세트만 노력도에 반영됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "RPE bắt đầu từ mục tiêu của kế hoạch. Chỉ những hiệp bạn tự chấm mới được tính vào gắng sức."
          }
        }
      }
    },
