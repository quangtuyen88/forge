    "Couldn't read that file. Export it again and retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read that file. Export it again and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込めませんでした。もう一度書き出して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 읽을 수 없어요. 다시 내보내고 재시도해 주세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được tệp. Xuất lại rồi thử lại."
          }
        }
      }
    },
    "Couldn't read that. Say the exercise, weight and reps, like deadlift 132.5 x 8.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read that. Say the exercise, weight and reps, like deadlift 132.5 x 8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞き取れませんでした。種目・重量・回数を、たとえば deadlift 132.5 x 8 のように話してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘 못 알아들었어요. 운동·무게·횟수를 'deadlift 132.5 x 8'처럼 말해 주세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nghe rõ. Hãy nói bài tập, mức tạ và số lần, ví dụ deadlift 132.5 x 8."
          }
        }
      }
    },
    "Couldn't save this set. Your numbers are still here — try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save this set. Your numbers are still here — try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセットを保存できませんでした。入力はそのまま残っています。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세트를 저장하지 못했습니다. 입력한 값은 그대로 있습니다. 다시 시도하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lưu được hiệp này. Số liệu của bạn vẫn còn — hãy thử lại."
          }
        }
      }
    },
