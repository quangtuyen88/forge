          }
        }
      }
    },
    "That is the whole loop. You log, I program.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is the whole loop. You log, I program."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが全体の流れです。あなたが記録し、私が組みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이게 전체 흐름이에요. 당신은 기록하고, 제가 설계해요."
