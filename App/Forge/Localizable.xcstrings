          }
        }
      }
    },
    "Set the machine or stack to the target. Plates per side do not apply here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the machine or stack to the target. Plates per side do not apply here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンまたはスタックを目標値に設定してください。片側プレートは該当しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신이나 스택을 목표에 맞추세요. 한쪽 원판은 해당하지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt máy hoặc khối tạ theo mục tiêu. Số bánh tạ mỗi bên không áp dụng ở đây."
          }
        }
      }
    },
    "Set the machine, stack or handles to the target. Plates per side do not apply here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the machine, stack or handles to the target. Plates per side do not apply here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン、スタック、またはハンドルを目標に設定してください。ここでは片側あたりのプレートは適用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신, 스택 또는 핸들을 목표로 설정하세요. 여기서는 한쪽당 플레이트가 적용되지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt máy, chồng tạ hoặc tay cầm về mức mục tiêu. Tạ đĩa mỗi bên không áp dụng ở đây."
          }
        }
      }
    },
    "Set up in Training setup › Gym profiles. The passport only adds what a number means on each unit.": {
