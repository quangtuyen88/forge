          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 값은 의도적으로 0입니다"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giá trị này cố ý bằng 0"
          }
        }
      }
    },
    "They log.": {
      "extractionState": "manual",
      "localizations": {
