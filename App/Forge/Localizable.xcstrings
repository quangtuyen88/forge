    "This sets your rep ranges. You can change it later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sets your rep ranges. You can change it later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これでレップ範囲が決まります。後から設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 선택으로 렙 범위가 정해져요. 나중에 설정에서 바꿀 수 있어요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn này đặt khoảng số lần của bạn. Bạn có thể đổi sau này trong Cài đặt."
          }
        }
      }
    },
