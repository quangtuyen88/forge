    "Loads adapt from what you just logged. Eat, sleep, come back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loads adapt from what you just logged. Eat, sleep, come back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録した内容から負荷を調整します。食べて、眠って、また来てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 기록한 것에서 중량이 조절돼요. 먹고, 자고, 다시 오세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức tạ điều chỉnh theo gì bạn vừa ghi. Ăn ngon, ngủ đủ, quay lại."
          }
        }
      }
    },
    "Loads already recorded against retired equipment stay readable. Restore an item if it comes back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loads already recorded against retired equipment stay readable. Restore an item if it comes back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用停止した器具に記録済みの負荷は引き続き表示されます。器具が戻ってきたら復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중지된 기구에 기록된 중량은 계속 읽을 수 있습니다. 기구가 다시 생기면 복원하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mức tạ đã ghi trên dụng cụ ngừng dùng vẫn đọc được. Khôi phục dụng cụ nếu nó quay lại."
          }
        }
      }
    },
    "Loads on different equipment are kept as separate baselines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loads on different equipment are kept as separate baselines."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "異なる器具の負荷は、別々のベースラインとして保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기구의 중량은 별도의 기준으로 유지됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức tạ trên các dụng cụ khác nhau được giữ thành các mức nền riêng."
          }
        }
      }
    },
    "Loads recorded under the old revision stay separate.": {
      "extractionState": "manual",
      "localizations": {
