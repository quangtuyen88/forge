    "%@ billed. Cancel any time before then in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ billed. Cancel any time before then in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が請求されます。それまでに設定からいつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@가 청구돼요. 그 전에 설정에서 언제든 취소할 수 있어요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu %@. Hủy bất cứ lúc nào trước đó trong Cài đặt."
          }
        }
      }
    },
    "%@ changes next session.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ changes next session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回のセッションで %1$@ が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 세션에서 %1$@ 이(가) 바뀝니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sẽ thay đổi ở buổi tới."
          }
        }
      }
    },
    "%@ coaches training, not medicine. For pain or injury, see a physio or doctor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ coaches training, not medicine. For pain or injury, see a physio or doctor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はトレーニングを指導するもので、医療ではありません。痛みやケガは理学療法士か医師に相談してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 훈련을 코칭하며 의료가 아닙니다. 통증이나 부상은 물리치료사나 의사를 만나세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ huấn luyện việc tập luyện, không phải chữa bệnh. Nếu đau hoặc chấn thương, hãy gặp chuyên gia vật lý trị liệu hoặc bác sĩ."
          }
        }
      }
    },
