          }
        }
      }
    },
    "Every session the plan asked for this week is either recorded or explicitly skipped. Regenerate the next week in the week designer when you're ready — nothing here changes on its own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every session the plan asked for this week is either recorded or explicitly skipped. Regenerate the next week in the week designer when you're ready — nothing here changes on its own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週プランが求めたセッションはすべて記録済みか明示的にスキップされています。準備ができたら週デザイナーで来週を再作成してください — ここでは何も自動で変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 계획이 요청한 모든 세션은 기록되거나 명시적으로 건너뛰었습니다. 준비되면 주간 설계에서 다음 주를 다시 생성하세요 — 여기는 저절로 변경되지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi buổi tập mà kế hoạch yêu cầu tuần này đều đã được ghi hoặc bị bỏ qua một cách rõ ràng. Hãy tạo lại tuần tiếp theo trong trình thiết kế tuần khi bạn sẵn sàng — không có gì ở đây tự thay đổi."
          }
        }
      }
    },
    "Every type is selected, which resolves to All.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every type is selected, which resolves to All."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての種類が選択されています。「すべて」と同じ扱いになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 유형이 선택되어 전체와 동일합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi loại đều được chọn, và điều này tương đương Tất cả."
          }
        }
      }
    },
    "Every workout you finish lands here with its sets, tonnage and duration — grouped by month, and editable afterwards.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every workout you finish lands here with its sets, tonnage and duration — grouped by month, and editable afterwards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了したワークアウトはすべて、セット、総重量、所要時間とともにここに記録されます — 月ごとにまとめられ、後から編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마친 모든 운동이 세트, 총 중량, 시간과 함께 여기에 표시되며 월별로 그룹화되고 나중에 편집할 수 있습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi buổi tập bạn hoàn thành đều xuất hiện ở đây cùng các hiệp, tổng khối lượng và thời lượng — được nhóm theo tháng, và có thể chỉnh sửa sau đó."
          }
        }
      }
    },
    "Everything repeats. Hit the same numbers cleaner.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything repeats. Hit the same numbers cleaner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全部キープ。同じ数字をよりきれいに仕上げましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전부 유지예요. 같은 수치를 더 깔끔하게 해내세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả giữ nguyên. Làm cùng con số đó sạch hơn."
          }
        }
      }
