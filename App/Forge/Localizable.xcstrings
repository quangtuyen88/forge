    "Each link expires on its own date and can be revoked. Revoking stops future access; a copy already saved by someone else cannot be recalled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each link expires on its own date and can be revoked. Revoking stops future access; a copy already saved by someone else cannot be recalled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各リンクはそれぞれの日に失効し、取り消すこともできます。取り消すと今後のアクセスが停止しますが、誰かがすでに保存したコピーは回収できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 링크는 자체 날짜에 만료되며 철회할 수 있습니다. 철회하면 향후 접근이 중단되지만, 이미 다른 사람이 저장한 사본은 회수할 수 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi liên kết hết hạn vào ngày riêng của nó và có thể bị thu hồi. Thu hồi sẽ chặn truy cập trong tương lai; bản sao đã được người khác lưu thì không thể thu hồi lại."
          }
        }
      }
    },
    "Early deload · two red days in a row": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
