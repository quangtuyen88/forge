    "%lld hidden. Hiding only removes an entry from the timeline — the record behind it stays exactly where it was.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hidden. Hiding only removes an entry from the timeline — the record behind it stays exactly where it was."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件を非表示にしました。非表示にするのはエントリーをタイムラインから外すだけで、その背後にある記録は元の場所にそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 숨김. 숨기기는 항목을 타임라인에서만 제거하며, 그 뒤의 기록은 원래 위치에 그대로 남습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang ẩn %lld mục. Ẩn chỉ gỡ một mục khỏi dòng thời gian — bản ghi đứng sau vẫn nằm nguyên chỗ cũ."
          }
        }
      }
