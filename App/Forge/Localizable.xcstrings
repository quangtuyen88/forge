    "Your gym profiles list %lld items. %lld of them — machines and cables — arrive as Needs review, because the app will not guess their unit or what their numbers mean.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your gym profiles list %lld items. %lld of them — machines and cables — arrive as Needs review, because the app will not guess their unit or what their numbers mean."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジムプロフィールには%1$lld個の器具があります。そのうち%2$lld個（マシンとケーブル）は要確認として扱われます。アプリがその単位や数値の意味を推測しないためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헬스장 프로필에 %lld개 항목이 있습니다. 그중 %lld개(머신과 케이블)는 검토 필요로 표시됩니다. 앱이 단위나 숫자의 의미를 추측하지 않기 때문입니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ phòng tập của bạn liệt kê %lld dụng cụ. %lld trong đó — máy tập và máy cáp — sẽ vào dạng Cần xem lại, vì ứng dụng không đoán đơn vị hay ý nghĩa con số của chúng."
          }
        }
      }
    },
    "Your gym profiles list %lld items. Adding them does not change any load already recorded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your gym profiles list %lld items. Adding them does not change any load already recorded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジムプロフィールには%lld個の器具があります。追加しても、すでに記録された負荷は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헬스장 프로필에 %lld개 항목이 있습니다. 추가해도 이미 기록된 중량은 변경되지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ phòng tập của bạn liệt kê %lld dụng cụ. Thêm vào không làm thay đổi mức tạ nào đã ghi."
          }
        }
      }
    },
