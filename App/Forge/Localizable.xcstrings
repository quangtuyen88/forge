    "That doesn't match what I showed you, so I didn't apply it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't match what I showed you, so I didn't apply it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示した内容と一致しないため、適用しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보여드린 내용과 달라서 적용하지 않았습니다."
