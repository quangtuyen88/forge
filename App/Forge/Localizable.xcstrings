    "Sharing hands the finished image to another app. Regulift does not post it for you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing hands the finished image to another app. Regulift does not post it for you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有すると完成した画像が他のアプリに渡されます。Reguliftが代わりに投稿することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유하면 완성된 이미지가 다른 앱으로 전달됩니다. Regulift가 대신 게시하지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ sẽ chuyển ảnh đã hoàn thiện sang ứng dụng khác. Regulift không đăng thay bạn."
