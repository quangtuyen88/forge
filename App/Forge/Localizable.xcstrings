    "My %@ has stopped progressing. What should I change?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My %@ has stopped progressing. What should I change?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私の%@の進捗が止まりました。何を変更すべきですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@가 더 이상 진전되지 않습니다. 무엇을 바꿔야 할까요?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ của tôi đã ngừng tiến bộ. Tôi nên thay đổi gì?"
          }
        }
      }
    },
    "My Progress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Progress"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイプログレス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 진행"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiến độ của tôi"
          }
        }
      }
    },
    "My body weight is down %@ over four weeks. Why, and should I change anything?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My body weight is down %@ over four weeks. Why, and should I change anything?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4週間で体重が%@減りました。なぜですか？何か変更すべきですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4주 동안 체중이 %@ 줄었습니다. 이유가 무엇이고, 무엇을 바꿔야 할까요?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cân nặng của tôi giảm %@ trong bốn tuần. Tại sao, và tôi có nên thay đổi gì không?"
          }
        }
      }
    },
    "My body weight is up %@ over four weeks. Is that on track for my goal?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My body weight is up %@ over four weeks. Is that on track for my goal?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4週間で体重が%@増えました。これは私の目標に対して順調ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4주 동안 체중이 %@ 늘었습니다. 목표에 부합하나요?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cân nặng của tôi tăng %@ trong bốn tuần. Như vậy có đúng hướng với mục tiêu của tôi không?"
          }
        }
      }
    },
    "My goal is %@ and I train %lld days a week. Is that split right for me?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My goal is %@ and I train %lld days a week. Is that split right for me?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私の目標は%1$@で、週%2$lld日トレーニングしています。このスプリットは私に合っていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제 목표는 %1$@이고 주 %2$lld일 운동합니다. 이 분할이 저에게 맞나요?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục tiêu của tôi là %1$@ và tôi tập %2$lld ngày mỗi tuần. Lịch chia đó có phù hợp với tôi không?"
          }
        }
      }
    },
    "My last three check-ins average %@ hours of sleep. Should I change my training this week?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My last three check-ins average %@ hours of sleep. Should I change my training this week?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近3回のチェックインの平均睡眠は%@時間です。今週のトレーニングを変更すべきですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 세 번의 체크인 평균 수면 시간이 %@시간입니다. 이번 주 훈련을 바꿔야 할까요?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba lần điểm danh gần đây của tôi trung bình ngủ %@ giờ. Tôi có nên thay đổi việc tập luyện tuần này không?"
          }
        }
      }
    },
