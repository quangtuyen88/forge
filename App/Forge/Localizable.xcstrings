    "Audio goes to Apple, never to Regulift; off, it never leaves this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio goes to Apple, never to Regulift; off, it never leaves this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声はAppleに送られ、Reguliftには決して送られません。オフの場合、音声がこの端末から出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성은 Apple로 전송되며 Regulift로는 전송되지 않습니다. 끄면 이 기기를 떠나지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh được gửi tới Apple, không bao giờ tới Regulift; tắt thì âm thanh không rời khỏi thiết bị này."
          }
        }
      }
