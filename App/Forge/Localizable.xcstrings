    },
    "Another suggestion already changed this same part of your plan, so I haven't changed anything. Undo that change in Settings → Training if you'd rather have this one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another suggestion already changed this same part of your plan, so I haven't changed anything. Undo that change in Settings → Training if you'd rather have this one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の提案がすでにプランの同じ部分を変更しているため、何も変更していません。こちらを選ぶ場合は、設定 → トレーニングでその変更を元に戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 제안이 이미 계획의 같은 부분을 변경했으므로 아무것도 변경하지 않았습니다. 이 변경을 원한다면 설정 → 훈련에서 해당 변경을 실행 취소하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một gợi ý khác đã thay đổi chính phần này trong kế hoạch của bạn, nên tôi chưa thay đổi gì. Hãy hoàn tác thay đổi đó trong Cài đặt → Tập luyện nếu bạn muốn dùng gợi ý này."
          }
        }
      }
    },
    "Answer on-device when possible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
