    "Hiding an entry only takes it out of the timeline. The workout, measurement, photo or note behind it is never deleted — it stays in History, Body stats and Photos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding an entry only takes it out of the timeline. The workout, measurement, photo or note behind it is never deleted — it stays in History, Body stats and Photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エントリーを非表示にすると、タイムラインから外れるだけです。その背後にあるワークアウト、測定、写真、メモが削除されることはありません。履歴、ボディスタッツ、写真に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 숨기면 타임라인에서만 제외됩니다. 그 뒤의 운동, 측정, 사진 또는 메모는 절대 삭제되지 않으며 기록, 바디 스탯, 사진에 남아 있습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn một mục chỉ gỡ nó khỏi dòng thời gian. Buổi tập, số đo, ảnh hay ghi chú đứng sau mục đó không bao giờ bị xóa — chúng vẫn nằm trong Lịch sử, Số đo cơ thể và Ảnh."
          }
        }
      }
    },
    "High fatigue — keep today conservative.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High fatigue — keep today conservative."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "疲労が高い — 今日は控えめに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피로가 높아요 — 오늘은 보수적으로."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mệt mỏi cao — hôm nay giữ mức thận trọng."
          }
        }
      }
    },
