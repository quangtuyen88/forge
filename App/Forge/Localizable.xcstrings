        }
      }
    },
    "Your plan changed after I showed you that, so nothing was changed. Ask again for a fresh version.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan changed after I showed you that, so nothing was changed. Ask again for a fresh version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示したあとに計画が変わったため、何も変更していません。最新版をもう一度聞いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보여드린 뒤에 계획이 바뀌어서 아무것도 변경하지 않았습니다. 최신 버전을 다시 요청해 주세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kế hoạch của bạn đã thay đổi sau khi tôi hiển thị, nên không có gì được thay đổi. Hãy hỏi lại để có bản mới."
          }
        }
      }
    },
    "Your plan changed for next week. Open the changes to see what moved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan changed for next week. Open the changes to see what moved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "来週の計画が変わりました。変更を開いて内容を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 주 계획이 바뀌었습니다. 변경 사항을 열어 무엇이 바뀌었는지 확인하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kế hoạch tuần tới đã thay đổi. Mở phần thay đổi để xem điều gì đã đổi."
          }
        }
      }
    },
    "Your plan has moved on since %@ suggested this, so I haven't changed anything. Ask again and I'll propose it against your current plan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan has moved on since %@ suggested this, so I haven't changed anything. Ask again and I'll propose it against your current plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がこれを提案した後にプランが進んだため、何も変更していません。もう一度聞いてください。現在のプランに対して提案します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@가 이것을 제안한 이후 계획이 변경되어 아무것도 변경하지 않았습니다. 다시 물어보시면 현재 계획에 맞춰 제안하겠습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kế hoạch của bạn đã thay đổi kể từ khi %@ gợi ý điều này, nên tôi chưa thay đổi gì. Hãy hỏi lại và tôi sẽ đề xuất dựa trên kế hoạch hiện tại của bạn."
          }
        }
      }
    },
    "Your question, your training log and your profile are sent to Regulift's coach service to write the answer. Nothing from Apple Health is sent. You can turn this off any time in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your question, your training log and your profile are sent to Regulift's coach service to write the answer. Nothing from Apple Health is sent. You can turn this off any time in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問・トレーニング記録・プロフィールは、回答を作成するReguliftのコーチサービスに送られます。Appleヘルスケアのデータは送信されません。設定からいつでもオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문, 훈련 기록, 프로필은 답을 쓰는 Regulift 코치 서비스로 전송돼요. Apple 건강 데이터는 보내지 않아요. 설정에서 언제든 끌 수 있어요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu hỏi, nhật ký tập và hồ sơ của bạn được gửi tới dịch vụ HLV của Regulift để viết câu trả lời. Không gửi dữ liệu Apple Sức khỏe. Bạn có thể tắt bất cứ lúc nào trong Cài đặt."
          }
        }
      }
    },
    "Your saved bar and plates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved bar and plates"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したシャフトとプレート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 바와 플레이트"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đòn và tạ đĩa đã lưu của bạn"
          }
        }
      }
    },
    "Your set is never deleted and never edited. Adherence, readiness and your program stay exactly as they are.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your set is never deleted and never edited. Adherence, readiness and your program stay exactly as they are."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットが削除・編集されることはありません。実行率、準備度、プログラムはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트는 절대 삭제되거나 편집되지 않습니다. 이행률, 준비도, 프로그램은 그대로 유지됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiệp của bạn không bao giờ bị xóa và không bao giờ bị sửa. Tuân thủ, mức sẵn sàng và chương trình của bạn vẫn giữ nguyên như hiện tại."
          }
        }
      }
    },
