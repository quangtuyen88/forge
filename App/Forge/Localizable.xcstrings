    "Pain or discomfort. Takes the separate safety route, no diagnosis.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pain or discomfort. Takes the separate safety route, no diagnosis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "痛みまたは不快感。別の安全ルートを取ります。診断は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
