    },
    "Optional. A link points at a record you already have and never changes it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. A link points at a record you already have and never changes it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。リンクは既存の記録を指すだけで、その記録を変更することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항. 링크는 이미 있는 기록을 가리키며 절대 변경하지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bắt buộc. Liên kết chỉ trỏ tới một bản ghi bạn đã có và không bao giờ thay đổi bản ghi đó."
          }
        }
      }
    },
    "Optional. Opens a sheet and changes nothing by itself": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Opens a sheet and changes nothing by itself"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。シートを開くだけで、それ自体は何も変更しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항. 시트를 열 뿐 자체적으로 아무것도 변경하지 않습니다"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn. Mở một bảng và tự nó không thay đổi gì"
          }
        }
      }
    },
    "Optional. Say what ended this set so the app stops reading it as a clean performance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Say what ended this set so the app stops reading it as a clean performance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。このセットが何で終わったかを伝えると、アプリはそれをクリーンな実施として扱わなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항. 세트를 끝낸 원인을 말하면 앱이 이를 깨끗한 수행으로 읽지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn. Hãy nói điều gì đã kết thúc hiệp này để ứng dụng không xem nó là một lần tập hoàn chỉnh."
          }
        }
      }
    },
    "Optional. Without it the app cannot total a plates-only load.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Without it the app cannot total a plates-only load."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。これがないと、アプリはプレートのみの負荷の合計を計算できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항. 이 값이 없으면 앱이 플레이트만의 중량 합계를 계산할 수 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bắt buộc. Không có nó, ứng dụng không tính được tổng mức tạ chỉ tính bánh tạ."
          }
        }
