          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획된 세션 %1$lld개%2$@가 %3$lld일%4$@ 남았습니다. %5$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "còn %1$lld buổi tập%2$@ theo kế hoạch với %3$lld ngày%4$@ còn lại. %5$@"
          }
