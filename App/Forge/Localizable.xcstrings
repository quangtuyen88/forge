    "%@ at %@: same unit and revision.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ at %@: same unit and revision."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
