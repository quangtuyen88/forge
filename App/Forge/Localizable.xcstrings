          }
        }
      }
    },
    "You have a session open. Pick up where you left off.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have a session open. Pick up where you left off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションが開いています。続きから始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 세션이 있어요. 하던 데부터 이어가세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn còn một buổi tập đang mở. Tiếp tục từ chỗ dừng."
          }
        }
      }
    },
    "You log reps and how hard the set felt. Regulift sets the next load and tells you why.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You log reps and how hard the set felt. Regulift sets the next load and tells you why."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レップ数とセットのきつさを記録すると、Regulift が次の負荷を決めて理由を伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렙 수와 세트의 힘든 정도를 기록하면 Regulift가 다음 중량을 정하고 이유를 알려줘요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn ghi số lần và mức gắng sức của hiệp. Regulift đặt mức tạ tiếp theo và giải thích lý do."
          }
        }
      }
    },
    "Your 6-week block": {
      "localizations": {
        "en": {
          "stringUnit": {
