        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là ngày hiện tại"
          }
        }
      }
    },
    "This only affects Crew. Adherence, readiness and your program read the same sets as before.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only affects Crew. Adherence, readiness and your program read the same sets as before."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはクルーにのみ影響します。実行率、準備度、プログラムは従来どおり同じセットを参照します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 크루에만 영향을 줍니다. 이행률, 준비도, 프로그램은 이전과 동일한 세트를 읽습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này chỉ ảnh hưởng đến Nhóm. Tuân thủ, mức sẵn sàng và chương trình của bạn vẫn đọc cùng các hiệp như trước."
          }
        }
      }
    },
    "This plan covers no session around today. Its days are the ones you laid out in the week designer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plan covers no session around today. Its days are the ones you laid out in the week designer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプランには今日前後のセッションがありません。日は週デザイナーで設定したものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계획은 오늘 주변의 세션을 포함하지 않습니다. 날짜는 주간 설계에서 배치한 것입니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kế hoạch này không bao gồm buổi tập nào quanh hôm nay. Các ngày của nó là những ngày bạn đã sắp xếp trong trình thiết kế tuần."
          }
        }
      }
    },
    "This plan is not this week": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plan is not this week"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプランは今週のものではありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계획은 이번 주 계획이 아닙니다"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kế hoạch này không phải tuần này"
          }
        }
      }
    },
    "This profile has no stable identifier yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile has no stable identifier yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルにはまだ安定した識別子がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필에는 아직 안정적인 식별자가 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ này chưa có mã định danh ổn định."
          }
        }
      }
    },
    "This record is no longer on this device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This record is no longer on this device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この記録はもうこの端末にはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기록은 더 이상 이 기기에 없습니다"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi này không còn trên thiết bị này"
          }
        }
      }
    },
    "This screen never reports a success rate. A change made inside a program that is also changing cannot be attributed to one recommendation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen never reports a success rate. A change made inside a program that is also changing cannot be attributed to one recommendation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面が成功率を報告することはありません。変化しつつあるプログラム内で行われた変更は、1つの推奨に帰属できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면은 성공률을 보고하지 않습니다. 함께 변경되는 프로그램 안에서 이루어진 변경은 하나의 추천으로 귀속될 수 없기 때문입니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình này không bao giờ báo tỷ lệ thành công. Một thay đổi được thực hiện bên trong một chương trình cũng đang thay đổi thì không thể quy cho một khuyến nghị duy nhất."
          }
        }
      }
    },
    "This set was edited after you wrote this note. Saving reattaches it to the current set; your text is kept either way.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This set was edited after you wrote this note. Saving reattaches it to the current set; your text is kept either way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセットは、このメモを書いた後に編集されました。保存すると現在のセットに再び紐づけられます。テキストはどちらの場合も保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세트는 메모를 작성한 후 편집되었습니다. 저장하면 현재 세트에 다시 연결되며, 텍스트는 어느 쪽이든 유지됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiệp này đã được sửa sau khi bạn viết ghi chú này. Việc lưu sẽ gắn lại nó vào hiệp hiện tại; văn bản của bạn vẫn được giữ trong mọi trường hợp."
          }
        }
      }
    },
    "This sets your rep ranges. You can change it later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sets your rep ranges. You can change it later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これでレップ範囲が決まります。後から設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 선택으로 렙 범위가 정해져요. 나중에 설정에서 바꿀 수 있어요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn này đặt khoảng số lần của bạn. Bạn có thể đổi sau này trong Cài đặt."
          }
        }
      }
    },
    "This suggestion didn't pass my own checks, so I haven't changed anything.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This suggestion didn't pass my own checks, so I haven't changed anything."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この提案は私自身のチェックを通らなかったため、何も変更していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제안은 제 검사를 통과하지 못해 아무것도 변경하지 않았습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gợi ý này không vượt qua các kiểm tra của chính tôi, nên tôi chưa thay đổi gì."
          }
        }
      }
    },
    "This was changed on another screen. Reopen it to continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This was changed on another screen. Reopen it to continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この内容は別の画面で変更されました。続けるには開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 화면에서 변경되었습니다. 계속하려면 다시 여세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung này đã bị thay đổi ở màn hình khác. Mở lại để tiếp tục."
          }
        }
      }
    },
