        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件の器具が負荷の意味が確定しないまま引き継がれました。そのため、その数値が何を数えているのか、どの単位なのかが分かりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 항목이 확인된 중량 의미 없이 이어졌으며, 따라서 그 숫자가 무엇을 세는지 또는 어떤 단위인지 알 수 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dụng cụ được mang sang mà chưa xác nhận ý nghĩa mức tạ, nên chúng tôi không biết con số của chúng tính gì hay chúng thuộc đơn vị nào."
          }
        }
      }
    },
