        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift 将你的语音转换为向教练提出的问题。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift biến giọng nói của bạn thành câu hỏi cho huấn luyện viên."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift listens only while you hold the mic button in the coach chat."
