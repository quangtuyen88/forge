        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift가 진행 사진을 이 기기에만 비공개로 저장합니다."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift turns your voice into a question for the coach."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reguliftはあなたの声をコーチへの質問に変換します。"
