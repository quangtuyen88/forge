        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift lưu ảnh tiến độ một cách riêng tư, chỉ trên thiết bị này."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift turns your voice into a question for the coach."
