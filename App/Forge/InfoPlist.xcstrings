        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift lưu các buổi tập sức mạnh vào ứng dụng Sức khỏe."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
