        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift dùng máy ảnh để quét mã vạch thực phẩm."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift reads sleep to adjust your daily fatigue score."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reguliftは睡眠データを読み取り、毎日の疲労スコアを調整します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift가 수면 데이터를 읽어 매일의 피로 점수를 조정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift 读取睡眠数据来调整每日疲劳评分。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift đọc dữ liệu giấc ngủ để điều chỉnh điểm mệt mỏi hằng ngày."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulift saves your strength workouts to Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reguliftはウェイトトレーニングをヘルスケアに保存します。"
