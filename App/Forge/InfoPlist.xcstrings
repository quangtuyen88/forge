{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift uses the camera to scan food barcodes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguliftは食品のバーコードをスキャンするためにカメラを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift가 식품 바코드를 스캔하기 위해 카메라를 사용합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift dùng máy ảnh để quét mã vạch thực phẩm."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift reads sleep, resting heart rate, heart rate and heart rate variability from Apple Health to score your daily readiness."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguliftは毎日の準備度を評価するため、Appleヘルスケアから睡眠、安静時心拍数、心拍数、心拍変動を読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift가 매일의 컨디션 점수를 매기기 위해 Apple 건강에서 수면, 안정 시 심박수, 심박수, 심박변동도를 읽습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift đọc giấc ngủ, nhịp tim nghỉ, nhịp tim và biến thiên nhịp tim từ Apple Sức khỏe để chấm điểm mức sẵn sàng hằng ngày."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift saves your strength workouts to Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ReguliftはウェイトトレーニングをAppleヘルスケアに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift가 근력 운동을 Apple 건강에 저장합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift lưu các buổi tập sức mạnh vào Apple Sức khỏe."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift stores your progress photos privately on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguliftは進捗写真をこの端末内にだけ保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift가 진행 사진을 이 기기에만 비공개로 저장합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift lưu ảnh tiến độ một cách riêng tư, chỉ trên thiết bị này."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift turns your voice into text for coach questions and workout commands."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguliftは、コーチへの質問とワークアウト操作のために音声をテキストに変換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift가 코치 질문과 운동 명령에 쓰도록 목소리를 텍스트로 바꿉니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift chuyển giọng nói của bạn thành văn bản cho câu hỏi với huấn luyện viên và các lệnh điều khiển buổi tập."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift listens while you talk to your coach or log sets by voice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguliftは、コーチとの会話や音声でのセット記録中に音声を聞き取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift가 코치와 대화하거나 음성으로 세트를 기록하는 동안 소리를 듣습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift lắng nghe khi bạn trò chuyện với huấn luyện viên hoặc ghi hiệp bằng giọng nói."
          }
        }
      }
    }
  },
  "version": "1.0"
}
