    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift reads sleep to adjust your daily fatigue score."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguliftは睡眠データを読み取り、毎日の疲労スコアを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift가 수면 데이터를 읽어 매일의 피로 점수를 조정합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift đọc dữ liệu giấc ngủ để điều chỉnh điểm mệt mỏi hằng ngày."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift saves your strength workouts to Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguliftはウェイトトレーニングをヘルスケアに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift가 근력 운동을 건강 앱에 저장합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulift lưu các buổi tập sức mạnh vào ứng dụng Sức khỏe."
          }
        }
      }
    }
  },
  "version": "1.0"
