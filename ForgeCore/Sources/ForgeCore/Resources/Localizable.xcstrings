{
  "sourceLanguage": "en",
  "strings": {
    "%@ changes next session.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ changes next session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回のセッションで %1$@ が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 세션에서 %1$@ 이(가) 바뀝니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sẽ thay đổi ở buổi tới."
          }
        }
      }
    },
    "%lld lifts progressing, %lld stalled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lifts progressing, %2$lld stalled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld種目が伸びていて、%2$lld種目が停滞しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld개 운동 향상, %2$lld개 정체"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bài tập đang tiến bộ, %lld bài đình trệ."
          }
        }
      }
    },
